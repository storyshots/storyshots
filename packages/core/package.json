{
  "name": "@storyshots/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/neutral/public.cjs",
  "module": "./dist/neutral/public.js",
  "types": "./dist/neutral/public.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/neutral/public.d.ts",
      "import": "./dist/neutral/public.js",
      "require": "./dist/neutral/public.cjs",
      "default": "./dist/neutral/public.js"
    },
    "./node": {
      "types": "./dist/node/public.d.ts",
      "import": "./dist/node/public.js",
      "require": "./dist/node/public.cjs",
      "default": "./dist/node/public.js"
    },
    "./browser": {
      "types": "./dist/browser/public.d.ts",
      "import": "./dist/browser/public.js",
      "require": "./dist/browser/public.cjs",
      "default": "./dist/browser/public.js"
    }
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/core/dist",
          "main": "packages/core/src/neutral/public.ts",
          "additionalEntryPoints": [
            "packages/core/src/node/public.ts",
            "packages/core/src/browser/public.ts"
          ],
          "tsConfig": "packages/core/tsconfig.lib.json",
          "format": [
            "esm",
            "cjs"
          ],
          "declarationRootDir": "packages/core/src"
        }
      },
      "check": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "npx nx run core:typecheck",
            "npx nx run core:build",
            "npx tsx --test packages/core/specs/**/*.spec.ts"
          ],
          "parallel": false
        }
      },
      "update-snapshots": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "npx tsx --test --test-update-snapshots packages/core/specs/**/*.spec.ts"
          ],
          "parallel": false
        }
      }
    }
  },
  "dependencies": {
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.58.2",
    "playwright-core": "^1.58.2",
    "pngjs": "^7.0.0",
    "safe-stable-stringify": "^2.5.0",
    "sanitize-filename": "^1.6.4",
    "slugify": "^1.6.9",
    "tarn": "^3.0.2"
  },
  "peerDependencies": {
    "looks-same": "^10.0.1"
  },
  "peerDependenciesMeta": {
    "looks-same": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "express": "^5.2.1",
    "looks-same": "^10.0.1"
  }
}
