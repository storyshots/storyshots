{
  "name": "@storyshots/utils",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "utils/dist",
          "main": "utils/src/index.ts",
          "tsConfig": "utils/tsconfig.lib.json",
          "format": [
            "esm"
          ],
          "declarationRootDir": "utils/src"
        }
      },
      "check": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "npx nx run utils:typecheck"
          ],
          "parallel": false
        }
      }
    }
  },
  "dependencies": {}
}
